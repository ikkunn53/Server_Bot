DISCORD_TOKEN=your-bot-token
GUILD_ID=
LOG_CHANNEL_ID=
# VC連続退出: 指定分数以内に指定回数退出すると、指定分数タイムアウト
# /settings のサーバー個別設定がある場合はそちらを優先します。
VOICE_DEPARTURE_COUNT=2
VOICE_DEPARTURE_WINDOW_MINUTES=1
VOICE_DEPARTURE_TIMEOUT_MINUTES=5
# 公開状態（ログイン不要）で閲覧できるプライバシーポリシーと利用規約のURL
PRIVACY_POLICY_URL=https://ikkunn53.github.io/Server_Bot/privacy-policy.html
TERMS_OF_SERVICE_URL=https://ikkunn53.github.io/Server_Bot/terms-of-service.html
DB_PATH=channelbot.db
# DB日次バックアップ設定
DB_DAILY_BACKUP_ENABLED=true
# UTC時刻を HH:mm 形式で指定（例: 03:00）。空欄なら日次バックアップは実行されません。
DB_DAILY_BACKUP_TIME_UTC=
DB_DAILY_BACKUP_DIR=data/backups
DB_DAILY_BACKUP_RETENTION_DAYS=14
