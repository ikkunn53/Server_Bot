DISCORD_TOKEN=your-bot-token
GUILD_ID=
LOG_CHANNEL_ID=
# 公開状態（ログイン不要）で閲覧できるプライバシーポリシーと利用規約のURL
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_OF_SERVICE_URL=https://example.com/terms
DB_PATH=channelbot.db
# DB日次バックアップ設定
DB_DAILY_BACKUP_ENABLED=true
# UTC時刻を HH:mm 形式で指定（例: 03:00）。空欄なら日次バックアップは実行されません。
DB_DAILY_BACKUP_TIME_UTC=
DB_DAILY_BACKUP_DIR=data/backups
DB_DAILY_BACKUP_RETENTION_DAYS=14
